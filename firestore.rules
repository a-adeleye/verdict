rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth != null ? request.auth.token.role : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isOwnerFor(entityId) {
      return isSignedIn() && exists(/databases/$(database)/documents/entityOwners/$(entityId + '_' + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /entities/{entityId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviewResponses/{responseId} {
      allow read: if true;
      allow create, update: if (isOwnerFor(request.resource.data.entityId) && request.resource.data.ownerUserId == request.auth.uid) || isAdmin();
      allow delete: if (isOwnerFor(resource.data.entityId) && resource.data.ownerUserId == request.auth.uid) || isAdmin();
    }

    match /entityOwners/{ownerId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create, update, delete: if isAdmin();
    }

    match /ownershipClaims/{claimId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /flags/{flagId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
